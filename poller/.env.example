# === 신도림 SNMP ===
SNMP_COMMUNITY=your_16_char_community_string

# === 공덕 ICC HTTP API ===
ICC_URL=http://192.168.0.210:8800
ICC_USER=
ICC_PASSWORD=
ICC_SITE_ID=1
# 본사 ICC 관측용 사이트 ID (0 또는 미지정 = 관측 안 함). 판정에는 사용하지 않음
ICC_HQ_SITE_ID=0

# === DB (poller는 network_mode: host) ===
POLLER_DB_HOST=192.168.0.x
POLLER_DB_PORT=5432
POLLER_DB_NAME=your_database_name
POLLER_DB_USER=your_user
POLLER_DB_PASSWORD=your_password_special_chars_ok

# === Google Chat 알림 (선택, 빈 값이면 알림 비활성) ===
NOTIFIER_WEBHOOK_URL=
# 알림 HTTP 타임아웃(초). 미지정 시 3
NOTIFIER_TIMEOUT=3
# 발송 실패 알림 보관 큐 최대 건수. 초과 시 오래된 것부터 폐기. 미지정 시 50
NOTIFIER_QUEUE_MAX=50
# 큐 보관 알림 만료 시간(분). 이보다 오래된 항목은 재전송하지 않고 폐기. 미지정 시 60
NOTIFIER_QUEUE_MAX_AGE_MIN=60

# === 로깅 ===
POLLER_LOG_LEVEL=INFO
POLLER_LOG_FILE=poller/poller.log
POLLER_DRY_RUN=false
